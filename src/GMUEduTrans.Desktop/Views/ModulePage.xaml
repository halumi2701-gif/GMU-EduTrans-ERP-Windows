<Page
    x:Class="GMUEduTrans.Desktop.Views.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28">
        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" Opacity=".65" TextWrapping="Wrap"/>
            <Border Margin="0,18,0,0" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock Text="Modul native siap dikembangkan dan dihubungkan ke service ERP."/>
            </Border>
        </StackPanel>
    </Grid>
</Page>