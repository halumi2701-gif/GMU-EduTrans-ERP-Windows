<Page
    x:Class="GMUEduTrans.Desktop.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Dashboard Owner" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Pantau aktivitas, booking, keuangan, dan operasional GMU EduTrans." Opacity=".65" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Target Pax" Opacity=".65"/><TextBlock x:Name="TargetPaxText" Text="400" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Peserta Bulan Ini" Opacity=".65"/><TextBlock x:Name="PesertaText" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Omzet" Opacity=".65"/><TextBlock x:Name="OmzetText" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="18" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Laba Bersih" Opacity=".65"/><TextBlock x:Name="LabaText" Text="—" FontSize="27" FontWeight="SemiBold"/></StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Ringkasan Aktivitas" FontSize="19" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="TargetProgress" Minimum="0" Maximum="400" Value="0" Height="8"/>
                        <TextBlock x:Name="TargetCaption" Text="Menunggu sinkronisasi data ERP…" Opacity=".65"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Aksi Cepat" FontSize="19" FontWeight="SemiBold"/>
                        <Button Content="+ Booking Baru" HorizontalAlignment="Stretch"/>
                        <Button Content="+ Lead Baru" HorizontalAlignment="Stretch"/>
                        <Button Content="Buat Rundown" HorizontalAlignment="Stretch"/>
                        <Button Content="Buka Laporan" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>